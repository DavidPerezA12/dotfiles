[user]
	name = David Perez

[core]
	editor = nvim
	excludesfile = ~/.gitignore_global
	autocrlf = input

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true
	default = current

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[diff]
	algorithm = histogram
	colorMoved = plain

[merge]
	conflictstyle = zdiff3

[alias]
	a = add
	aa = add --all
	ap = add --patch
	b = branch
	ba = branch --all
	c = commit
	ca = commit --amend
	cane = commit --amend --no-edit
	co = checkout
	cp = cherry-pick
	d = diff
	ds = diff --staged
	l = log --oneline --decorate --graph
	la = log --oneline --decorate --graph --all
	last = log -1 HEAD --stat
	pf = push --force-with-lease
	s = status --short --branch
	st = status
	sw = switch
	swc = switch --create
	uncommit = reset --soft HEAD~1
	unstage = restore --staged

[include]
	path = ~/.gitconfig.local

# GitHub credentials come from the gh CLI (run `gh auth login` once per
# machine). The empty helper clears anything inherited from the system config,
# and gh is resolved through PATH so this works on Intel and Apple Silicon.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
